{
  "name": "battle-of-intelligence",
  "version": "0.0.0",
  "private": true,
  "description": "Claude and GPT compete in five original games, judged by code and replayed as a narrated broadcast.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "voices": "node scripts/voices.ts",
    "commentate": "node scripts/commentate.ts",
    "fight:ring": "node scripts/fight-ring.ts",
    "fight:bluff": "node scripts/fight-bluff.ts",
    "fight:buzzer": "node scripts/fight-buzzer.ts",
    "fight:mirror": "node scripts/fight-mirror.ts",
    "fight:brawl": "node scripts/fight-brawl.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "lucide-react": "^1.59.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ashishkaloge/battle-of-intelligence.git"
  },
  "homepage": "https://github.com/ashishkaloge/battle-of-intelligence#readme",
  "bugs": {
    "url": "https://github.com/ashishkaloge/battle-of-intelligence/issues"
  }
}
